# copy to .env and fill in. Regions and keywords are in config.json

SERPAPI_KEY=

# LLM: any api in the OpenAI format, default is OpenAI itself
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=

# DeepSeek instead: swap the 3 lines above for these
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=

# optional proxy for page downloads, curl -x format: http://user:pass@host:port
PROXY_URL=

# optional, values below are the defaults
# pages labelled at once, lower it if the llm api answers 429 (rate limit)
# LLM_CONCURRENCY=12
# a labelled url is reused this many days, then labelled again
# ANALYSIS_TTL_DAYS=30
